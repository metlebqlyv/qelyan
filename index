<!DOCTYPE html>
<html lang="az">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Qəlyan çəkək?</title>
<style>
:root{--bg:#f3e6d6;--ink:#3b2418;--yes:#2f7d5b;--no:#8a6a58;--card:#fff8ef;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1e1410;--ink:#f3e6d6;--yes:#3fa377;--no:#a8846f;--card:#2a1c16}}
:root[data-theme="dark"]{--bg:#1e1410;--ink:#f3e6d6;--yes:#3fa377;--no:#a8846f;--card:#2a1c16}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--ink);font-family:Georgia,"Times New Roman",serif;display:flex;align-items:center;justify-content:center;overflow:hidden}
main{text-align:center;padding:24px;width:100%;max-width:520px}
.cup{line-height:1}#hk{height:170px;width:auto;max-width:80%;transition:height .3s}
h1{font-size:clamp(28px,8vw,40px);margin:12px 0 6px;line-height:1.15}
p{margin:0 0 28px;opacity:.75;font-size:18px}
.row{display:flex;align-items:center;justify-content:center;gap:14px;min-height:40vh;flex-wrap:wrap}
button{font-family:inherit;border:0;border-radius:999px;cursor:pointer;color:#fff;transition:all .25s ease;white-space:nowrap}
#yes{background:var(--yes);font-size:20px;padding:14px 32px}
#no{background:var(--no);font-size:20px;padding:14px 32px}
#msg{min-height:1.4em;margin-top:8px;font-size:16px;opacity:.8}
.done h1{font-size:clamp(30px,9vw,46px)}
.steam{animation:bob 1.6s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(-8px)}}
@media (prefers-reduced-motion:reduce){.steam{animation:none}button{transition:none}}
</style>
</head>
<body>
<main id="app">
  <div class="cup steam" id="cup"><img id="hk" alt="Qəlyan" src="data:image/webp;base64,"></div>
  <h1 id="title">Mənimlə qəlyan çəkməyə gələrsən?</h1>
  <p id="sub">Qəlyan sənin hesabına.</p>
  <div class="row" id="row">
    <button id="yes">Hə</button>
    <button id="no">Yox</button>
  </div>
  <div id="msg"></div>
  <div id="pick" style="display:none;margin-top:20px">
    <input id="dt" type="datetime-local" style="font:inherit;font-size:18px;padding:12px 16px;border-radius:14px;border:2px solid var(--yes);background:var(--card);color:var(--ink);max-width:100%">
    <div><a id="send" href="#" target="_blank" rel="noopener" style="display:none;margin-top:16px;background:var(--yes);color:#fff;padding:14px 28px;border-radius:999px;text-decoration:none;font-size:18px">WhatsApp-a göndər</a></div>
  </div>
</main>
<script>
var yes=document.getElementById('yes'),no=document.getElementById('no'),msg=document.getElementById('msg');
var yS=20,yP=32,nS=20,nP=32,count=0;
var lines=["Yox mən geyəm 🙄","Dırnağa gedəcəm 💅","Salona gedəcəm 💇‍♀️","Dırnağım qırılıb 😭","Saçım hazır deyil ki 😩","Artıq hə-dən başqa yol yoxdur"];
function apply(){
  yes.style.fontSize=yS+'px';yes.style.padding=(yS*.7)+'px '+(yS*1.6)+'px';
  no.style.fontSize=nS+'px';no.style.padding=(nS*.7)+'px '+(nS*1.6)+'px';
}
function shrink(e){
  if(e)e.preventDefault();
  count++;
  yS=Math.min(yS*1.25,160);
  if(count>lines.length){no.style.display='none';apply();return}
  no.textContent=lines[count-1];
  apply();
}
no.addEventListener('click',shrink);
no.addEventListener('touchstart',shrink,{passive:false});
yes.addEventListener('click',function(){
  document.getElementById('app').classList.add('done');
  document.getElementById('title').textContent='Yaşasın! Deməli, razısan 🎉';
  document.getElementById('sub').textContent='İndi tarix və vaxtı seç 📅';
  document.getElementById('row').style.display='none';
  msg.textContent='';
  document.getElementById('hk').style.height='200px';
  document.getElementById('pick').style.display='block';
});
function mk(){
  var v=document.getElementById('dt').value,l=document.getElementById('send');
  if(!v){l.style.display='none';return}
  var d=new Date(v);
  var mo=['yanvar','fevral','mart','aprel','may','iyun','iyul','avqust','sentyabr','oktyabr','noyabr','dekabr'];
  var t=('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2);
  var txt='Hə razıyam! Qəlyan üçün tarix: '+d.getDate()+' '+mo[d.getMonth()]+' '+d.getFullYear()+', saat '+t+' 💨';
  l.href='https://wa.me/994514538953?text='+encodeURIComponent(txt);
  l.style.display='inline-block';
}
document.getElementById('dt').addEventListener('input',mk);
document.getElementById('dt').addEventListener('change',mk);
apply();
</script>
</body>
</html>
